{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>bcgov/renovate-config#2026.9.26"
  ],
  "helm-values": {
    "managerFilePatterns": [
      "/(^|/)values.*\\.yaml$/"
    ]
  },
  "pip_requirements": {
    "managerFilePatterns": [
      "/^src\\/backend\\/requirements\\/development\\.txt$/"
    ]
  },
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["registry.redhat.io/**"],
      "enabled": false
    },
    {
      "matchDatasources": ["npm"],
      "matchPackageNames": ["@fortawesome/**", "@awesome.me/**"],
      "enabled": false
    }
  ]
}
